---
dependency:
  name: galaxy
  options:
    requirements-file: requirements.yml

driver:
  name: {{ container_driver }}

platforms:
  - name: instance-ubuntu2404
    image: geerlingguy/docker-ubuntu2404-ansible:latest
    pre_build_image: true
    privileged: true
    volumes:
      - /sys/fs/cgroup:/sys/fs/cgroup:rw
    cgroupns_mode: host
    command: /lib/systemd/systemd
    groups:
      - linux_servers

  - name: instance-debian12
    image: geerlingguy/docker-debian12-ansible:latest
    pre_build_image: true
    privileged: true
    volumes:
      - /sys/fs/cgroup:/sys/fs/cgroup:rw
    cgroupns_mode: host
    command: /lib/systemd/systemd
    groups:
      - linux_servers

  - name: instance-debian13
    image: geerlingguy/docker-debian13-ansible:latest
    pre_build_image: true
    privileged: true
    volumes:
      - /sys/fs/cgroup:/sys/fs/cgroup:rw
    cgroupns_mode: host
    command: /lib/systemd/systemd
    groups:
      - linux_servers

  - name: instance-rocky9
    image: geerlingguy/docker-rockylinux9-ansible:latest
    pre_build_image: true
    privileged: true
    volumes:
      - /sys/fs/cgroup:/sys/fs/cgroup:rw
    cgroupns_mode: host
    command: /usr/sbin/init
    groups:
      - linux_servers

provisioner:
  name: ansible
  config_options:
    defaults:
      roles_path: ../../roles
      callbacks_enabled: ansible.posix.profile_tasks
  inventory:
    group_vars:
      linux_servers:
        env_name: dev
        remote_user: {{ remote_user }}

verifier:
  name: ansible
