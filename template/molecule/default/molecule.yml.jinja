---
{% set distro_images = {
  'debian13': 'geerlingguy/docker-debian13-ansible:latest',
  'debian12': 'geerlingguy/docker-debian12-ansible:latest',
  'ubuntu2404': 'geerlingguy/docker-ubuntu2404-ansible:latest',
  'rocky9': 'geerlingguy/docker-rockylinux9-ansible:latest'
} -%}
{% set distro_commands = {
  'debian13': '/lib/systemd/systemd',
  'debian12': '/lib/systemd/systemd',
  'ubuntu2404': '/lib/systemd/systemd',
  'rocky9': '/usr/sbin/init'
} -%}
dependency:
  name: galaxy
  options:
    requirements-file: requirements.yml

driver:
  name: {{ container_driver }}

platforms:
  - name: instance-{{ linux_distro }}
    image: {{ distro_images[linux_distro] }}
    pre_build_image: true
    privileged: true
    volumes:
      - /sys/fs/cgroup:/sys/fs/cgroup:rw
    cgroupns_mode: host
    command: {{ distro_commands[linux_distro] }}
    groups:
      - linux_servers

provisioner:
  name: ansible
  config_options:
    defaults:
      roles_path: ../../roles
      callbacks_enabled: ansible.posix.profile_tasks
  inventory:
    group_vars:
      linux_servers:
        env_name: dev
        remote_user: {{ remote_user }}

verifier:
  name: ansible
