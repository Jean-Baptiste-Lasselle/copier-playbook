---
- name: Verify rootless Podman and SSH password authentication
  hosts: linux_servers
  gather_facts: false
  vars:
    test_user: {{ remote_user }}
{% raw %}
  tasks:
    - name: Check Podman binary is installed and executable
      ansible.builtin.command: podman --version
      changed_when: false

    - name: Get UID of rootless user
      ansible.builtin.command: "id -u {{ test_user }}"
      register: test_user_uid
      changed_when: false

    - name: Verify subordinate UID mapping exists for rootless user
      ansible.builtin.command: "grep -E '^{{ test_user }}:' /etc/subuid"
      changed_when: false

    - name: Verify systemd lingering is enabled for rootless user
      ansible.builtin.stat:
        path: "/var/lib/systemd/linger/{{ test_user }}"
      register: linger_file
      failed_when: not linger_file.stat.exists

    - name: Run rootless Podman info as target user
      ansible.builtin.command: podman info --format '{{.Host.Security.Rootless}}'
      become: true
      become_user: "{{ test_user }}"
      environment:
        XDG_RUNTIME_DIR: "/run/user/{{ test_user_uid.stdout }}"
      register: rootless_check
      changed_when: false
      failed_when: rootless_check.stdout != "true"

    - name: Verify SSH password authentication is explicitly enabled
      ansible.builtin.command: grep -E "^PasswordAuthentication yes$" /etc/ssh/sshd_config.d/99-ansible-password-auth.conf
      changed_when: false
{% endraw %}
